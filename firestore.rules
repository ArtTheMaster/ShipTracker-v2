rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isStaffOrAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') in ['admin', 'staff'];
    }

    match /users/{userId} {
      allow read: if isStaffOrAdmin() || 
                     (request.auth != null && request.auth.uid == userId) || 
                     (request.auth != null && resource.data.role in ['admin', 'staff']);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /parcels/{parcelId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /returns/{returnId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /analytics/{docId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /customers/{customerId} {
      allow read: if isStaffOrAdmin() || (request.auth != null && resource.data.linkedUid == request.auth.uid);
      allow write: if request.auth != null; 
    }

    match /order_requests/{requestId} {
      allow read: if isStaffOrAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaffOrAdmin();
    }

    match /support_chats/{chatId} {
      allow read: if isStaffOrAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.customerUid == request.auth.uid;
      allow update: if isStaffOrAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      
      match /messages/{messageId} {
        allow read: if isStaffOrAdmin() || (request.auth != null && get(/databases/$(database)/documents/support_chats/$(chatId)).data.customerUid == request.auth.uid);
        allow create: if isStaffOrAdmin() || (request.auth != null && get(/databases/$(database)/documents/support_chats/$(chatId)).data.customerUid == request.auth.uid);
      }
    }
  }
}